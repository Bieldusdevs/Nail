{
  "name": "lume-atelier",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@lume/web",
    "build": "cd apps/web && npx --no-install next build --webpack",
    "lint": "npm run lint --workspace=@lume/web",
    "typecheck": "npm run typecheck --workspace=@lume/web",
    "test": "npm run test --workspace=@lume/web",
    "test:e2e": "npm exec --workspace=@lume/web -- playwright test",
    "api:test": "cd apps/api && ./mvnw -B -ntp test",
    "api:verify": "cd apps/api && ./mvnw -B -ntp verify",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
