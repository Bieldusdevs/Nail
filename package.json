{
  "name": "lume-atelier",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@lume/web",
    "build": "npm run build --workspace=@lume/web",
    "lint": "npm run lint --workspace=@lume/web",
    "typecheck": "npm run typecheck --workspace=@lume/web",
    "test": "npm run test --workspace=@lume/web",
    "test:e2e": "npm exec --workspace=@lume/web -- playwright test",
    "api:test": "cd apps/api && ./mvnw -B -ntp test",
    "api:verify": "cd apps/api && ./mvnw -B -ntp verify",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml}": "prettier --write"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
